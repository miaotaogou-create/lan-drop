<RCC>
    <qresource prefix="/icons">
        <file alias="paperclip.svg">paperclip.svg</file>
        <file alias="folder-plus.svg">folder-plus.svg</file>
        <file alias="zap.svg">zap.svg</file>
        <file alias="send.svg">send.svg</file>
        <file alias="settings.svg">settings.svg</file>
        <file alias="badge-terminal.svg">badge-terminal.svg</file>
        <file alias="badge-cpu.svg">badge-cpu.svg</file>
        <file alias="badge-server.svg">badge-server.svg</file>
        <file alias="badge-phone.svg">badge-phone.svg</file>
        <file alias="chevron-down.svg">chevron-down.svg</file>
        <file alias="globe.svg">globe.svg</file>
        <file alias="settings-white.svg">settings-white.svg</file>
    </qresource>
    <qresource prefix="/avatars">
        <file>avatar_ubuntu.svg</file>
        <file>avatar_raspberrypi.svg</file>
        <file>avatar_windows.svg</file>
        <file>avatar_iphone.svg</file>
    </qresource>
</RCC>
